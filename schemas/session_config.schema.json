{
  "$defs": {
    "Competency": {
      "description": "Scored competencies from the spec, grouped by interview type in COMPETENCIES_BY_TYPE.",
      "enum": [
        "ownership",
        "impact",
        "collaboration",
        "conflict_handling",
        "learning_from_failure",
        "communication",
        "role_fit",
        "depth_of_experience",
        "judgment",
        "motivation",
        "team_fit",
        "scope_at_level",
        "technical_depth",
        "accuracy",
        "reasoning",
        "trade_offs",
        "clarity_of_explanation",
        "problem_framing",
        "structure",
        "user_and_business_sense",
        "estimation_logic",
        "prioritization",
        "recommendation"
      ],
      "title": "Competency",
      "type": "string"
    },
    "CustomCategory": {
      "additionalProperties": false,
      "description": "One question category in a Custom session (CU-1, CU-2).",
      "properties": {
        "category": {
          "enum": [
            "behavioral",
            "hiring_manager",
            "technical_qa",
            "case"
          ],
          "type": "string"
        },
        "focus": {
          "description": "Topics to focus on, for example 'conflict' or 'Kubernetes' (CU-2).",
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Focus",
          "type": "array"
        },
        "share": {
          "description": "Share of the core time. Shares add up to 1.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Share",
          "type": "number"
        }
      },
      "required": [
        "category",
        "share"
      ],
      "title": "CustomCategory",
      "type": "object"
    },
    "CustomQuestion": {
      "additionalProperties": false,
      "description": "A question the candidate wrote or saved (CU-3, CU-4).",
      "properties": {
        "category": {
          "enum": [
            "behavioral",
            "hiring_manager",
            "technical_qa",
            "case"
          ],
          "type": "string"
        },
        "competencies": {
          "description": "From COMPETENCIES_BY_TYPE for the category. Tagged by the CU-5 check.",
          "items": {
            "$ref": "#/$defs/Competency"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Competencies",
          "type": "array"
        },
        "must_ask": {
          "default": true,
          "description": "CU-4: the session controller asks it.",
          "title": "Must Ask",
          "type": "boolean"
        },
        "saved_question_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CU-8: the saved_questions row it came from.",
          "title": "Saved Question Id"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "verbatim": {
          "default": false,
          "description": "CU-4: read the text word for word.",
          "title": "Verbatim",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "category",
        "competencies"
      ],
      "title": "CustomQuestion",
      "type": "object"
    },
    "CustomSessionSpec": {
      "additionalProperties": false,
      "description": "What the candidate builds for a Custom session. Stored in sessions.custom_json.",
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/CustomCategory"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Categories",
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/CustomQuestion"
          },
          "maxItems": 8,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "categories"
      ],
      "title": "CustomSessionSpec",
      "type": "object"
    },
    "Difficulty": {
      "description": "IV-4.",
      "enum": [
        "friendly",
        "realistic",
        "tough"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "InterviewType": {
      "description": "The four v1 interview types (IV-2), plus Custom (CU-1).\n\nA Custom session mixes 1 to 3 of the four standard types as question categories\n(`SessionConfig.custom`). Custom is never a question category itself and has no entry in\nCOMPETENCIES_BY_TYPE; use `session_competencies(config)` for a session's competency pool.",
      "enum": [
        "behavioral",
        "hiring_manager",
        "technical_qa",
        "case",
        "custom"
      ],
      "title": "InterviewType",
      "type": "string"
    },
    "Level": {
      "description": "Normalized seniority (IV-6). Company-specific labels such as L5 or E5 map to these.",
      "enum": [
        "new_grad",
        "mid",
        "senior",
        "staff_principal"
      ],
      "title": "Level",
      "type": "string"
    },
    "Mode": {
      "description": "IV-8. Only Realistic sessions count toward progress trends (PR-1).",
      "enum": [
        "coach",
        "realistic"
      ],
      "title": "Mode",
      "type": "string"
    }
  },
  "$id": "https://strong-hire.local/schemas/session_config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What the candidate picks before a session (journey 2, step 1).",
  "properties": {
    "custom": {
      "anyOf": [
        {
          "$ref": "#/$defs/CustomSessionSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "CU-1: required for the Custom type, absent for the others."
    },
    "difficulty": {
      "$ref": "#/$defs/Difficulty"
    },
    "duration_min": {
      "description": "10 is a mini interview.",
      "enum": [
        10,
        30,
        45
      ],
      "title": "Duration Min",
      "type": "integer"
    },
    "interview_type": {
      "$ref": "#/$defs/InterviewType"
    },
    "level": {
      "$ref": "#/$defs/Level"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    }
  },
  "required": [
    "interview_type",
    "difficulty",
    "mode",
    "duration_min",
    "level"
  ],
  "title": "SessionConfig",
  "type": "object"
}
