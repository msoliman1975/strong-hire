{
  "$defs": {
    "Competency": {
      "description": "Scored competencies from the spec, grouped by interview type in COMPETENCIES_BY_TYPE.",
      "enum": [
        "ownership",
        "impact",
        "collaboration",
        "conflict_handling",
        "learning_from_failure",
        "communication",
        "role_fit",
        "depth_of_experience",
        "judgment",
        "motivation",
        "team_fit",
        "scope_at_level",
        "technical_depth",
        "accuracy",
        "reasoning",
        "trade_offs",
        "clarity_of_explanation",
        "problem_framing",
        "structure",
        "user_and_business_sense",
        "estimation_logic",
        "prioritization",
        "recommendation"
      ],
      "title": "Competency",
      "type": "string"
    },
    "StoryNote": {
      "additionalProperties": false,
      "description": "ST-6: a fix note sent to the story from a debrief answer that used it.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "question_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "QuestionScore.question_ref.",
          "title": "Question Ref"
        },
        "session_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The debrief's session.",
          "title": "Session Id"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "at"
      ],
      "title": "StoryNote",
      "type": "object"
    },
    "StorySource": {
      "description": "ST-1: where a story came from.",
      "enum": [
        "debrief_answer",
        "manual",
        "coach"
      ],
      "title": "StorySource",
      "type": "string"
    },
    "StoryStatus": {
      "description": "ST-1, ST-7: a story is a draft until a Realistic answer that used it scores 3 or more.",
      "enum": [
        "draft",
        "proven"
      ],
      "title": "StoryStatus",
      "type": "string"
    }
  },
  "$id": "https://strong-hire.local/schemas/story.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "ST-1: one story in the user's library. The stories table holds org_id and user_id.",
  "properties": {
    "action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action"
    },
    "context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "notes": {
      "items": {
        "$ref": "#/$defs/StoryNote"
      },
      "title": "Notes",
      "type": "array"
    },
    "reflection": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reflection"
    },
    "result": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "skills": {
      "description": "Skill tags.",
      "items": {
        "$ref": "#/$defs/Competency"
      },
      "title": "Skills",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/StorySource"
    },
    "source_question_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ST-2: QuestionScore.question_ref of that answer.",
      "title": "Source Question Ref"
    },
    "source_session_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ST-2: the session of the debrief answer it came from.",
      "title": "Source Session Id"
    },
    "stakes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stakes"
    },
    "status": {
      "$ref": "#/$defs/StoryStatus",
      "default": "draft"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "source",
    "created_at",
    "updated_at"
  ],
  "title": "Story",
  "type": "object"
}
