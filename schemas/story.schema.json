{
  "$defs": {
    "ActionStep": {
      "additionalProperties": false,
      "description": "SC-2: one action step. `did` and `why` are core (D-4); the other two are optional.",
      "properties": {
        "alternatives": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutlineSlot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "did": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutlineSlot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "people": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutlineSlot"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How you brought people along."
        },
        "why": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutlineSlot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ActionStep",
      "type": "object"
    },
    "Competency": {
      "description": "Scored competencies from the spec, grouped by interview type in COMPETENCIES_BY_TYPE.",
      "enum": [
        "ownership",
        "impact",
        "collaboration",
        "conflict_handling",
        "learning_from_failure",
        "communication",
        "role_fit",
        "depth_of_experience",
        "judgment",
        "motivation",
        "team_fit",
        "scope_at_level",
        "technical_depth",
        "accuracy",
        "reasoning",
        "trade_offs",
        "clarity_of_explanation",
        "problem_framing",
        "structure",
        "user_and_business_sense",
        "estimation_logic",
        "prioritization",
        "recommendation",
        "logistics_and_expectations",
        "discovery",
        "objection_handling",
        "value_articulation",
        "closing"
      ],
      "title": "Competency",
      "type": "string"
    },
    "OutlineSection": {
      "additionalProperties": false,
      "description": "SC-2: one section of the outline with its named slots. Missing keys are empty slots.",
      "properties": {
        "metric": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultMetric"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Result only."
        },
        "section": {
          "$ref": "#/$defs/StorySection"
        },
        "slots": {
          "additionalProperties": {
            "$ref": "#/$defs/OutlineSlot"
          },
          "title": "Slots",
          "type": "object"
        },
        "steps": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ActionStep"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Action only: 1 to 5 steps, in order.",
          "title": "Steps"
        }
      },
      "required": [
        "section"
      ],
      "title": "OutlineSection",
      "type": "object"
    },
    "OutlineSlot": {
      "additionalProperties": false,
      "description": "SC-2, D-6: one slot of the outline. A filled slot Strova wrote carries the candidate's\nverbatim `quotes`; a slot the candidate typed is `by_user` and needs none.",
      "properties": {
        "by_user": {
          "default": false,
          "description": "True when the candidate typed the text.",
          "title": "By User",
          "type": "boolean"
        },
        "quotes": {
          "description": "The candidate's words this slot came from, verbatim.",
          "items": {
            "type": "string"
          },
          "title": "Quotes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SlotStatus",
          "default": "empty"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Markdown. Set only when filled.",
          "title": "Text"
        }
      },
      "title": "OutlineSlot",
      "type": "object"
    },
    "ResultMetric": {
      "additionalProperties": false,
      "description": "SC-2: the Result section's metric. `text` says it in words; `before`, `after` and `unit`\nhold the numbers when the candidate gave them.",
      "properties": {
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "by_user": {
          "default": false,
          "description": "True when the candidate typed the text.",
          "title": "By User",
          "type": "boolean"
        },
        "quotes": {
          "description": "The candidate's words this slot came from, verbatim.",
          "items": {
            "type": "string"
          },
          "title": "Quotes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SlotStatus",
          "default": "empty"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Markdown. Set only when filled.",
          "title": "Text"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "title": "ResultMetric",
      "type": "object"
    },
    "SlotStatus": {
      "description": "SC-2, D-5: one outline slot is filled, still empty, or skipped by the candidate.",
      "enum": [
        "filled",
        "empty",
        "skipped"
      ],
      "title": "SlotStatus",
      "type": "string"
    },
    "StoryNote": {
      "additionalProperties": false,
      "description": "ST-6: a fix note sent to the story from a debrief answer that used it.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "question_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "QuestionScore.question_ref.",
          "title": "Question Ref"
        },
        "session_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The debrief's session.",
          "title": "Session Id"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "at"
      ],
      "title": "StoryNote",
      "type": "object"
    },
    "StoryOutline": {
      "additionalProperties": false,
      "description": "SC-2, D-3: the source of truth of a styled story. The five legacy columns are rendered\nfrom it in code (D-12, SC-14).",
      "properties": {
        "sections": {
          "items": {
            "$ref": "#/$defs/OutlineSection"
          },
          "title": "Sections",
          "type": "array"
        },
        "style": {
          "$ref": "#/$defs/StoryStyle"
        }
      },
      "required": [
        "style",
        "sections"
      ],
      "title": "StoryOutline",
      "type": "object"
    },
    "StorySection": {
      "description": "SC-2, D-3: the sections of a story outline. Which ones a story has depends on its style.",
      "enum": [
        "situation",
        "challenge",
        "task",
        "action",
        "result",
        "learning"
      ],
      "title": "StorySection",
      "type": "string"
    },
    "StorySource": {
      "description": "ST-1: where a story came from.",
      "enum": [
        "debrief_answer",
        "manual",
        "coach"
      ],
      "title": "StorySource",
      "type": "string"
    },
    "StoryStatus": {
      "description": "ST-1, ST-7: a story is a draft until a Realistic answer that used it scores 3 or more.",
      "enum": [
        "draft",
        "proven"
      ],
      "title": "StoryStatus",
      "type": "string"
    },
    "StoryStyle": {
      "description": "SC-1, D-1: the writing style of a crafted story. A classic story has no style (null).",
      "enum": [
        "star",
        "carl"
      ],
      "title": "StoryStyle",
      "type": "string"
    }
  },
  "$id": "https://strong-hire.local/schemas/story.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "ST-1: one story in the user's library. The stories table holds org_id and user_id.",
  "properties": {
    "action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action"
    },
    "archived_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "CS-13: when it was archived; null when not archived.",
      "title": "Archived At"
    },
    "context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deleted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "CS-15: when it was deleted; restorable for 30 days.",
      "title": "Deleted At"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "notes": {
      "items": {
        "$ref": "#/$defs/StoryNote"
      },
      "title": "Notes",
      "type": "array"
    },
    "outline": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoryOutline"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "SC-2: the outline of a styled story; null when classic."
    },
    "reflection": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reflection"
    },
    "result": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "skills": {
      "description": "Skill tags.",
      "items": {
        "$ref": "#/$defs/Competency"
      },
      "title": "Skills",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/StorySource"
    },
    "source_question_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ST-2: QuestionScore.question_ref of that answer.",
      "title": "Source Question Ref"
    },
    "source_session_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ST-2: the session of the debrief answer it came from.",
      "title": "Source Session Id"
    },
    "stakes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stakes"
    },
    "status": {
      "$ref": "#/$defs/StoryStatus",
      "default": "draft"
    },
    "style": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoryStyle"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "SC-1: star or carl; null for a classic story (D-11)."
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "source",
    "created_at",
    "updated_at"
  ],
  "title": "Story",
  "type": "object"
}
