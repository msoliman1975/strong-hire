{
  "$defs": {
    "FlowFlag": {
      "additionalProperties": false,
      "description": "SC-9, D-9: one advisory flow flag. `key` is stable for the same issue, so a dismissed\nflag stays dismissed until the slots it cites change.",
      "properties": {
        "key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "question": {
          "description": "What Strova would ask about it.",
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "slots": {
          "description": "The slots the flag is about.",
          "items": {
            "$ref": "#/$defs/SlotRef"
          },
          "minItems": 1,
          "title": "Slots",
          "type": "array"
        },
        "type": {
          "$ref": "#/$defs/FlowFlagType"
        }
      },
      "required": [
        "key",
        "type",
        "slots",
        "question"
      ],
      "title": "FlowFlag",
      "type": "object"
    },
    "FlowFlagType": {
      "description": "SC-9, D-9: the kinds of advisory flags the flow check raises.",
      "enum": [
        "action_vs_problem",
        "result_vs_problem",
        "number_conflict",
        "timeline_conflict",
        "loose_end"
      ],
      "title": "FlowFlagType",
      "type": "string"
    },
    "SlotRef": {
      "additionalProperties": false,
      "description": "Points at one slot: a named slot of a section, or a field of one action step.",
      "properties": {
        "section": {
          "$ref": "#/$defs/StorySection"
        },
        "slot": {
          "description": "A slot key, `metric`, or a step field.",
          "minLength": 1,
          "title": "Slot",
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "exclusiveMaximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Action only: the step index.",
          "title": "Step"
        }
      },
      "required": [
        "section",
        "slot"
      ],
      "title": "SlotRef",
      "type": "object"
    },
    "StorySection": {
      "description": "SC-2, D-3: the sections of a story outline. Which ones a story has depends on its style.",
      "enum": [
        "situation",
        "challenge",
        "task",
        "action",
        "result",
        "learning"
      ],
      "title": "StorySection",
      "type": "string"
    }
  },
  "$id": "https://strong-hire.local/schemas/flow_check.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "SC-9: the result of one flow check. No flags means the story hangs together.",
  "properties": {
    "flags": {
      "items": {
        "$ref": "#/$defs/FlowFlag"
      },
      "title": "Flags",
      "type": "array"
    }
  },
  "title": "FlowCheck",
  "type": "object"
}
