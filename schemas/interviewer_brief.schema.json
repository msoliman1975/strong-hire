{
  "$defs": {
    "BriefQuestion": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "enum": [
                "behavioral",
                "hiring_manager",
                "technical_qa",
                "case"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom sessions only: the question's category (CU-1)."
        },
        "competencies": {
          "items": {
            "$ref": "#/$defs/Competency"
          },
          "minItems": 1,
          "title": "Competencies",
          "type": "array"
        },
        "id": {
          "description": "Stable id, used as Turn.question_ref.",
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "must_ask": {
          "default": false,
          "description": "CU-4: the session controller asks it before CANDIDATE_QUESTIONS.",
          "title": "Must Ask",
          "type": "boolean"
        },
        "priority": {
          "description": "1 is asked first.",
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "probe_hints": {
          "items": {
            "type": "string"
          },
          "title": "Probe Hints",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/QuestionSource",
          "default": "planner",
          "description": "CU-3: candidate for the candidate's own."
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "values": {
          "description": "Company values this question probes (target_values).",
          "items": {
            "type": "string"
          },
          "title": "Values",
          "type": "array"
        },
        "verbatim": {
          "default": false,
          "description": "CU-4: read the text word for word.",
          "title": "Verbatim",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "competencies",
        "priority"
      ],
      "title": "BriefQuestion",
      "type": "object"
    },
    "Competency": {
      "description": "Scored competencies from the spec, grouped by interview type in COMPETENCIES_BY_TYPE.",
      "enum": [
        "ownership",
        "impact",
        "collaboration",
        "conflict_handling",
        "learning_from_failure",
        "communication",
        "role_fit",
        "depth_of_experience",
        "judgment",
        "motivation",
        "team_fit",
        "scope_at_level",
        "technical_depth",
        "accuracy",
        "reasoning",
        "trade_offs",
        "clarity_of_explanation",
        "problem_framing",
        "structure",
        "user_and_business_sense",
        "estimation_logic",
        "prioritization",
        "recommendation",
        "logistics_and_expectations",
        "discovery",
        "objection_handling",
        "value_articulation",
        "closing"
      ],
      "title": "Competency",
      "type": "string"
    },
    "CustomCategory": {
      "additionalProperties": false,
      "description": "One question category in a Custom session (CU-1, CU-2).",
      "properties": {
        "category": {
          "enum": [
            "behavioral",
            "hiring_manager",
            "technical_qa",
            "case"
          ],
          "type": "string"
        },
        "focus": {
          "description": "Topics to focus on, for example 'conflict' or 'Kubernetes' (CU-2).",
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Focus",
          "type": "array"
        },
        "share": {
          "description": "Share of the core time. Shares add up to 1.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Share",
          "type": "number"
        }
      },
      "required": [
        "category",
        "share"
      ],
      "title": "CustomCategory",
      "type": "object"
    },
    "CustomQuestion": {
      "additionalProperties": false,
      "description": "A question the candidate wrote or saved (CU-3, CU-4).",
      "properties": {
        "category": {
          "enum": [
            "behavioral",
            "hiring_manager",
            "technical_qa",
            "case"
          ],
          "type": "string"
        },
        "competencies": {
          "description": "From COMPETENCIES_BY_TYPE for the category. Tagged by the CU-5 check.",
          "items": {
            "$ref": "#/$defs/Competency"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Competencies",
          "type": "array"
        },
        "must_ask": {
          "default": true,
          "description": "CU-4: the session controller asks it.",
          "title": "Must Ask",
          "type": "boolean"
        },
        "saved_question_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CU-8: the saved_questions row it came from.",
          "title": "Saved Question Id"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "verbatim": {
          "default": false,
          "description": "CU-4: read the text word for word.",
          "title": "Verbatim",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "category",
        "competencies"
      ],
      "title": "CustomQuestion",
      "type": "object"
    },
    "CustomSessionSpec": {
      "additionalProperties": false,
      "description": "What the candidate builds for a Custom session. Stored in sessions.custom_json.",
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/CustomCategory"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Categories",
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/CustomQuestion"
          },
          "maxItems": 8,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "categories"
      ],
      "title": "CustomSessionSpec",
      "type": "object"
    },
    "Difficulty": {
      "description": "IV-4.",
      "enum": [
        "friendly",
        "realistic",
        "tough"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "InterviewType": {
      "description": "The four v1 interview types (IV-2), plus Custom (CU-1) and Recruiter screen (RS-1).\n\nA Custom session mixes 1 to 3 of the four standard types as question categories\n(`SessionConfig.custom`). Custom is never a question category itself and has no entry in\nCOMPETENCIES_BY_TYPE; use `session_competencies(config)` for a session's competency pool.",
      "enum": [
        "behavioral",
        "hiring_manager",
        "technical_qa",
        "case",
        "custom",
        "recruiter_screen",
        "role_play"
      ],
      "title": "InterviewType",
      "type": "string"
    },
    "Level": {
      "description": "Normalized seniority (IV-6). Company-specific labels such as L5 or E5 map to these.",
      "enum": [
        "new_grad",
        "mid",
        "senior",
        "staff_principal"
      ],
      "title": "Level",
      "type": "string"
    },
    "Mode": {
      "description": "IV-8. Only Realistic sessions count toward progress trends (PR-1).",
      "enum": [
        "coach",
        "realistic"
      ],
      "title": "Mode",
      "type": "string"
    },
    "PersonaBrief": {
      "additionalProperties": false,
      "properties": {
        "closing_style": {
          "minLength": 1,
          "title": "Closing Style",
          "type": "string"
        },
        "pushback_style": {
          "minLength": 1,
          "title": "Pushback Style",
          "type": "string"
        },
        "tone": {
          "minLength": 1,
          "title": "Tone",
          "type": "string"
        }
      },
      "required": [
        "tone",
        "pushback_style",
        "closing_style"
      ],
      "title": "PersonaBrief",
      "type": "object"
    },
    "Phase": {
      "description": "Session state machine phases (IV-7). The session controller moves phases, not the LLM.",
      "enum": [
        "intro",
        "small_talk",
        "agenda",
        "core",
        "candidate_questions",
        "wrap_up"
      ],
      "title": "Phase",
      "type": "string"
    },
    "PhaseTime": {
      "additionalProperties": false,
      "description": "Minutes planned for one phase of the session (IV-7).",
      "properties": {
        "minutes": {
          "maximum": 45,
          "minimum": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        }
      },
      "required": [
        "phase",
        "minutes"
      ],
      "title": "PhaseTime",
      "type": "object"
    },
    "QuestionSource": {
      "description": "Who wrote a brief question: the planner, or the candidate in a Custom session (CU-3).",
      "enum": [
        "planner",
        "candidate"
      ],
      "title": "QuestionSource",
      "type": "string"
    },
    "RoleFamily": {
      "description": "Role families (RF-1, `docs/role-families-spec.md`). Per-family facts live in\n`strong_core.role_families`; per-family model guidance in `prompts/planner/family_<value>`.",
      "enum": [
        "swe",
        "data_ml",
        "pm",
        "design",
        "tpm",
        "other",
        "infra_security",
        "data_analytics",
        "eng_management",
        "finance",
        "consulting_strategy",
        "project_program",
        "sales",
        "customer_success"
      ],
      "title": "RoleFamily",
      "type": "string"
    },
    "RolePlayBrief": {
      "additionalProperties": false,
      "description": "RP-3, D-4: the hidden buyer brief. The live interviewer plays this buyer; the scorer\nreads it to judge discovery and closing. Never shown to the candidate before the debrief.",
      "properties": {
        "budget": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Budget",
          "type": "string"
        },
        "company_summary": {
          "description": "The buyer's company.",
          "maxLength": 300,
          "minLength": 1,
          "title": "Company Summary",
          "type": "string"
        },
        "curveball": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tough only (D-8).",
          "title": "Curveball"
        },
        "decision_process": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Decision Process",
          "type": "string"
        },
        "hidden_pains": {
          "description": "Said only when good discovery earns them.",
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Hidden Pains",
          "type": "array"
        },
        "objections": {
          "items": {
            "$ref": "#/$defs/RolePlayObjection"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Objections",
          "type": "array"
        },
        "persona_name": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Persona Name",
          "type": "string"
        },
        "persona_title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Persona Title",
          "type": "string"
        },
        "product": {
          "description": "What the candidate sells.",
          "maxLength": 240,
          "minLength": 1,
          "title": "Product",
          "type": "string"
        },
        "product_illustrative": {
          "default": false,
          "description": "D-9: true when the posting named no product and the planner described one.",
          "title": "Product Illustrative",
          "type": "boolean"
        },
        "scenario": {
          "$ref": "#/$defs/RolePlayScenario"
        },
        "situation": {
          "description": "Why this call is happening.",
          "maxLength": 400,
          "minLength": 1,
          "title": "Situation",
          "type": "string"
        },
        "success_condition": {
          "description": "What earns the next step, e.g. a booked demo.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Success Condition",
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "persona_name",
        "persona_title",
        "company_summary",
        "product",
        "situation",
        "hidden_pains",
        "budget",
        "decision_process",
        "objections",
        "success_condition"
      ],
      "title": "RolePlayBrief",
      "type": "object"
    },
    "RolePlayObjection": {
      "additionalProperties": false,
      "description": "One objection the buyer raises in a role-play (RP-3).",
      "properties": {
        "text": {
          "description": "What the buyer says.",
          "maxLength": 240,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "when": {
          "description": "When to raise it, e.g. \"after the price\".",
          "maxLength": 160,
          "minLength": 1,
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "text",
        "when"
      ],
      "title": "RolePlayObjection",
      "type": "object"
    },
    "RolePlayScenario": {
      "description": "RP-4, D-5: the kind of call a role-play simulates. The escalation call (CS-1) is a\ncustomer success call with an existing, unhappy customer.",
      "enum": [
        "cold_call",
        "discovery_call",
        "demo_objections",
        "negotiation_close",
        "escalation_call"
      ],
      "title": "RolePlayScenario",
      "type": "string"
    },
    "SessionConfig": {
      "additionalProperties": false,
      "description": "What the candidate picks before a session (journey 2, step 1).",
      "properties": {
        "custom": {
          "anyOf": [
            {
              "$ref": "#/$defs/CustomSessionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CU-1: required for the Custom type, absent for the others."
        },
        "difficulty": {
          "$ref": "#/$defs/Difficulty"
        },
        "duration_min": {
          "description": "10 is a mini interview.",
          "enum": [
            10,
            30,
            45
          ],
          "title": "Duration Min",
          "type": "integer"
        },
        "interview_type": {
          "$ref": "#/$defs/InterviewType"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "role_play": {
          "anyOf": [
            {
              "$ref": "#/$defs/RolePlayScenario"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RP-4, D-5: the call to simulate; required for Role-play only."
        },
        "tone": {
          "$ref": "#/$defs/Tone",
          "default": "as_company",
          "description": "TN-1: the interviewer's tone. as_company uses the profile persona's tone."
        }
      },
      "required": [
        "interview_type",
        "difficulty",
        "mode",
        "duration_min",
        "level"
      ],
      "title": "SessionConfig",
      "type": "object"
    },
    "Tone": {
      "description": "TN-1: how the interviewer sounds. `as_company` uses the company profile's persona tone,\nor a neutral tone in generic mode. Old sessions read as `as_company`.",
      "enum": [
        "as_company",
        "warm",
        "neutral",
        "direct"
      ],
      "title": "Tone",
      "type": "string"
    }
  },
  "$id": "https://strong-hire.local/schemas/interviewer_brief.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Built by the planner before each session. The live interviewer reads only this.",
  "properties": {
    "coach_help": {
      "default": false,
      "description": "Coach mode only: pause, hint and redo are allowed (IV-8).",
      "title": "Coach Help",
      "type": "boolean"
    },
    "company_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None in generic mode.",
      "title": "Company Name"
    },
    "company_summary": {
      "anyOf": [
        {
          "maxLength": 1200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "AP-2: a short company summary from an auto-generated profile, shown to the interviewer labeled auto-generated. None for curated profiles and generic mode.",
      "title": "Company Summary"
    },
    "curveball": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Tough difficulty only (IV-4).",
      "title": "Curveball"
    },
    "generic_mode": {
      "title": "Generic Mode",
      "type": "boolean"
    },
    "max_probes_per_question": {
      "description": "IV-3: at most 3. Role-play: the buyer's replies per beat, at most 8 (RP-6).",
      "maximum": 8,
      "minimum": 0,
      "title": "Max Probes Per Question",
      "type": "integer"
    },
    "persona": {
      "$ref": "#/$defs/PersonaBrief"
    },
    "probe_areas": {
      "items": {
        "type": "string"
      },
      "title": "Probe Areas",
      "type": "array"
    },
    "profile_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Version"
    },
    "pushback": {
      "default": false,
      "description": "Tough difficulty only: challenge assumptions (IV-4).",
      "title": "Pushback",
      "type": "boolean"
    },
    "questions": {
      "description": "6 to 10; a mini interview has 3. Role-play: 2 to 4 beats, a mini has 1.",
      "items": {
        "$ref": "#/$defs/BriefQuestion"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Questions",
      "type": "array"
    },
    "role_family": {
      "$ref": "#/$defs/RoleFamily",
      "default": "other",
      "description": "RF-5: the job's role family, set from the posting, never by the model. Picks the family guidance for the interviewer and the scorer. Briefs stored before RF-5 read as other."
    },
    "role_play": {
      "anyOf": [
        {
          "$ref": "#/$defs/RolePlayBrief"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "RP-3: the hidden buyer brief, for Role-play sessions only. Never shown to the candidate before the debrief."
    },
    "seniority_bar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Scope expected at session.level (IV-6). Level changes the bar.",
      "title": "Seniority Bar"
    },
    "session": {
      "$ref": "#/$defs/SessionConfig"
    },
    "target_competencies": {
      "description": "4 to 6; a mini interview has 2.",
      "items": {
        "$ref": "#/$defs/Competency"
      },
      "maxItems": 6,
      "minItems": 2,
      "title": "Target Competencies",
      "type": "array"
    },
    "target_values": {
      "description": "Company value names (Principle.name) to probe. Empty in generic mode.",
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Target Values",
      "type": "array"
    },
    "time_plan": {
      "description": "Minutes per phase. When set, the minutes add up to session.duration_min.",
      "items": {
        "$ref": "#/$defs/PhaseTime"
      },
      "title": "Time Plan",
      "type": "array"
    }
  },
  "required": [
    "session",
    "generic_mode",
    "target_competencies",
    "questions",
    "persona",
    "max_probes_per_question"
  ],
  "title": "InterviewerBrief",
  "type": "object"
}
