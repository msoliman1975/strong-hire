# Test server (infra/compose.server.yaml). Caddy gets TLS certificates from Let's Encrypt.

# The candidate app. The admin API routes are never reachable from this origin (D-1).
{$DOMAIN} {
	encode gzip
	handle_path /api/* {
		@admin path /admin /admin/*
		respond @admin 404
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# The admin app (D-1, docs/admin-spec.md), built into /srv-admin (outside /srv, so the candidate
# host never serves it). Its own /api proxy, so the session cookie is host-only on this host.
# Strict headers (AA-9): only same-origin scripts, styles, images and requests; no framing.
admin.{$DOMAIN} {
	encode gzip
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	handle_path /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv-admin
		try_files {path} /index.html
		file_server
	}
}

# LiveKit signaling (WebSocket). Media goes direct to 7881/tcp and 7882/udp.
rtc.{$DOMAIN} {
	reverse_proxy livekit:7880
}
