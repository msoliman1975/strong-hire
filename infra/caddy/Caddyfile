# Test server (infra/compose.server.yaml). Caddy gets TLS certificates from Let's Encrypt.

# The candidate app. The admin API routes are never reachable from this origin (D-1).
# It answers on app. (where sign-in and email links now go) and, until the marketing site takes
# the apex (docs/hosting.md "Marketing site"), on the apex too, so old links keep working.
app.{$DOMAIN}, {$DOMAIN} {
	encode gzip
	handle_path /api/* {
		@admin path /admin /admin/*
		respond @admin 404
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# The admin app (D-1, docs/admin-spec.md), built into /srv-admin (outside /srv, so the candidate
# host never serves it). Its own /api proxy, so the session cookie is host-only on this host.
# Strict headers (AA-9): only same-origin scripts, styles, images and requests; no framing.
admin.{$DOMAIN} {
	encode gzip
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	handle_path /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv-admin
		try_files {path} /index.html
		file_server
	}
}

# The marketing site (L04, apps/site), static files built into /srv-site. Until the domain switch
# it is a preview on www, kept out of search engines (docs/hosting.md "Marketing site"). Only the
# public routes (the waitlist) are proxied to the API from this host. Strict headers: the site has
# no inline scripts or styles.
www.{$DOMAIN} {
	encode gzip
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://app.{$DOMAIN}"
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	handle /api/public/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}
	handle {
		root * /srv-site
		try_files {path} {path}.html
		file_server
	}
	handle_errors 404 {
		root * /srv-site
		rewrite * /404.html
		file_server
	}
}

# LiveKit signaling (WebSocket). Media goes direct to 7881/tcp and 7882/udp.
rtc.{$DOMAIN} {
	reverse_proxy livekit:7880
}
