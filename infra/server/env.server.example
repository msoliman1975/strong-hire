# Extra .env lines for the test server (docs/hosting.md). Copy .env.example to .env, then append
# these and fill them in. Generate each secret with: openssl rand -hex 32
STACK_TARGET=server
DOMAIN=getstronghire.com
SERVER_IP=

POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SESSION_SECRET=
STRONG_INTERNAL_TOKEN=
# Fernet key for resume files: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
INPUTS_STORAGE_KEY=

# Cost limits for the claude profile (scripts/profile.ps1).
CLAUDE_DAILY_BUDGET_USD=3
CLAUDE_MONTHLY_BUDGET_USD=30
CLAUDE_RPM_LIMIT=60
# Test plans (infra/server/grant-test-plans.sh): the owner and the first N other users.
TEST_PLAN_OWNER=
TEST_PLAN_SLOTS=3
TEST_PLAN_MINUTES=3000
# Comma-separated emails that see the model spend meter in the top bar.
MODEL_SPEND_VIEWERS=
# Comma-separated emails that may open the admin area (/admin): test interviews and traces.
ADMIN_EMAILS=msoliman_75@hotmail.com

# Sign-in by email link, through Brevo SMTP. The password is a Brevo SMTP key (xsmtpsib-...).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Strong Hire <no-reply@getstronghire.com>"
