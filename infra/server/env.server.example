# Extra .env lines for the test server (docs/hosting.md). Copy .env.example to .env, then append
# these and fill them in. Generate each secret with: openssl rand -hex 32
STACK_TARGET=server
DOMAIN=getstronghire.com
SERVER_IP=

POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SESSION_SECRET=
STRONG_INTERNAL_TOKEN=
# Fernet key for resume files: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
INPUTS_STORAGE_KEY=

# Cost limits for the claude profile (scripts/profile.ps1).
CLAUDE_DAILY_BUDGET_USD=3
CLAUDE_MONTHLY_BUDGET_USD=30
CLAUDE_RPM_LIMIT=60
# Comma-separated emails that see the model spend meter in the top bar.
MODEL_SPEND_VIEWERS=
# AA-1: comma-separated emails that seed the admins of https://admin.$DOMAIN on the first start,
# while admin_users is empty. After that it is ignored: use Settings > Admins or `strongctl admin`.
ADMIN_EMAILS=msoliman_75@hotmail.com

# Sign-in by email link, through Brevo SMTP. The password is a Brevo SMTP key (xsmtpsib-...).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Strong Hire <no-reply@getstronghire.com>"

# LLM tracing to MLflow (LT, docs/llm-tracing/spec.md, docs/hosting.md "LLM tracing (MLflow)").
# on starts the mlflow service (obs profile) and traces sim users' sessions only. Never set
# LLM_TRACING_DEV here: the server forces it off.
LLM_TRACING=off
MLFLOW_EXPERIMENT=sim
# Real users' traces (LT-16 to LT-31). Leave both off until their gate in
# docs/llm-tracing/phase2-gates.md is met (LT-30): PROD needs the privacy policy and retention
# schedule to describe it; PROD_CONTENT also needs the lawyer-approved consent wording.
LLM_TRACING_PROD=off
LLM_TRACING_PROD_CONTENT=off
LLM_TRACING_SAMPLE=1.0
# Admins open the traces at https://admin.$DOMAIN/mlflow/ with their admin sign-in (LT-28).
# The sim server logs to https://mlflow.$DOMAIN with this bearer token (its STRONGHIRE_MLFLOW_TOKEN).
# Make one with: openssl rand -hex 32. Empty: only signed-in admins reach MLflow.
MLFLOW_SIM_TOKEN=
