---
/**
 * Q4: the beta waitlist. Posts to the same endpoint as the app's /waitlist page
 * (POST /api/public/waitlist, L04 step 1), which always answers "check_email" and sends a
 * confirmation link (double opt-in). public/js/waitlist.js sends it; without JavaScript the
 * form links to the app's waitlist page instead.
 */
import { APP_URL, SUPPORT_EMAIL } from "../data/site";

interface Props {
  id?: string;
}
const { id = "join" } = Astro.props;

const WHEN = [
  ["two_weeks", "In the next two weeks"],
  ["month", "Within a month"],
  ["later", "Later than that"],
  ["not_yet", "No interview booked yet"],
] as const;
// RF-10: same order and labels as strong_core.role_families (a test checks them).
const ROLES = [
  ["swe", "Software engineering"],
  ["infra_security", "Infrastructure and security"],
  ["data_ml", "Data science and ML"],
  ["data_analytics", "Data analytics"],
  ["pm", "Product management"],
  ["design", "Design"],
  ["tpm", "Technical program management"],
  ["eng_management", "Engineering management"],
  ["finance", "Finance"],
  ["consulting_strategy", "Consulting and strategy"],
  ["project_program", "Project and program management"],
  ["other", "Other"],
] as const;
---

<section class="card" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>Join the beta waitlist</h2>
  <p class="muted">The beta opens in stages. People with the soonest interviews go first.</p>
  <form class="form" data-waitlist novalidate action={`${APP_URL}/waitlist`} method="get">
    <div class="field">
      <label for={`${id}-email`}>Email</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
      <p class="field-error" data-error="email" hidden>Enter an email address, for example name@example.com.</p>
    </div>
    <fieldset>
      <legend>When is your interview?</legend>
      {
        WHEN.map(([value, label]) => (
          <div class="check">
            <input id={`${id}-when-${value}`} type="radio" name="interview_within" value={value} />
            <label for={`${id}-when-${value}`}>{label}</label>
          </div>
        ))
      }
      <p class="field-error" data-error="interview_within" hidden>Choose one, so we can invite the soonest first.</p>
    </fieldset>
    <div class="field">
      <label for={`${id}-role`}>Your field (optional)</label>
      <select id={`${id}-role`} name="role_family">
        <option value="">Choose one</option>
        {ROLES.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>
    <div class="check">
      <input id={`${id}-marketing`} type="checkbox" name="marketing_consent" />
      <label for={`${id}-marketing`}>Also send me interview tips and product news. You can unsubscribe at any time.</label>
    </div>
    <div class="visually-hidden" aria-hidden="true">
      <label for={`${id}-website`}>Website</label>
      <input id={`${id}-website`} type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <div>
      <button class="btn" type="submit">Join the waitlist</button>
    </div>
    <p class="field-error" data-error="server" role="alert" hidden>
      Something went wrong. Try again in a minute, or write to {SUPPORT_EMAIL}.
    </p>
    <p class="small muted">
      Without the box above, we only email you to confirm this request and when your invite is ready. See the
      <a href="/legal/privacy">privacy policy</a>.
    </p>
  </form>
  <div data-done hidden tabindex="-1">
    <h3>Check your email</h3>
    <p>We sent you a link. Open it to confirm your place on the waitlist. It works for 7 days.</p>
  </div>
</section>
