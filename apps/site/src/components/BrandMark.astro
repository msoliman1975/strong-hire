---
/** The Strong Hire logo, "the Orbit" (SV-10; the same drawing as apps/web BrandMark). */
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<svg class="brand-mark" width={size} height={size} viewBox="0 0 48 48" aria-hidden="true">
  <path
    d="M41.56 20.03 A18 18 0 1 1 27.97 6.44"
    fill="none"
    stroke="var(--brand-ring)"
    stroke-width="5"
    stroke-linecap="round"></path>
  <circle cx="36.73" cy="11.27" r="5.5" fill="var(--brand-dot)"></circle>
</svg>
