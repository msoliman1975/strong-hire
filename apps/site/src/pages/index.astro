---
import Base from "../layouts/Base.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import {
  COMPANIES,
  COMPANY_COUNT,
  CTA,
  NOT_AFFILIATED,
  PRACTICE_NOTICE,
  READINESS_NOTICE,
  signupUrl,
} from "../data/site";

// The homepage tells the v2 story (UI-3): two journeys, build your stories with a coach and prep
// for an interview, both ending in a debrief. It keeps the briefed interviewer (spec "Interviewer
// brief"), how it reads a story, the tone and difficulty you choose, and why the same story
// scores differently for a different job. Every example is made up.
// Q3: company names only in one plain line, next to the notice.
const companiesLine =
  COMPANIES.length > 0
    ? `Practice for interviews at companies like ${COMPANIES.slice(0, 6).join(", ")} and ${COMPANY_COUNT - 6} more.`
    : `Practice for interviews at ${COMPANY_COUNT} major tech companies.`;

const SOURCES = [
  ["The company", "How they interview", "Their values framework, question style, the bar at each level, and how their interviewers push back."],
  ["The role", "What the job demands", "Level, must-haves, the problems the team owns, and the scope a hire at that level is expected to show."],
  ["You", "What your resume and stories prove", "Your projects and scope, the stories you've built, and the gaps between your experience and the role."],
] as const;

const BRIEF_COMPETENCIES = ["Ownership", "Cross-team influence", "Judgment", "Customer focus", "Impact at scale"];
const BRIEF_PROBES = [
  "The role asks for leading without authority. Your resume shows one team, not several.",
  "Payments is new to you. Expect “why this domain, why now”.",
  "Your launch numbers are strong. It will ask how you measured them.",
];

const JOURNEYS = [
  {
    kind: "stories",
    tag: "Build your stories",
    title: "Turn what you did into stories that hold up.",
    body: "A coach asks the questions an interviewer would, fills each part of the story from your own words, and scores every take you tell.",
    steps: ["Talk it through with the coach, by voice or text", "Practice it in takes, scored 1 to 4", "Get a 60-second and a full version"],
    href: "#stories",
    link: "See the story coach",
  },
  {
    kind: "prep",
    tag: "Prep for an interview",
    title: "Get ready for one real interview.",
    body: "Add the job posting and your resume. You get one plan: what they'll test, where they'll probe, which story fits each skill, and the days left.",
    steps: ["Check your CV against the job", "Rehearse with a briefed interviewer", "Read a debrief, then fix one thing"],
    href: "#prep",
    link: "See the interview plan",
  },
] as const;

// The story library: one story in five parts. Each part has a color and always a text label.
const STORY_PARTS = [
  ["context", "Context", "Checkout ran on a vendor's payment page. Three teams owned pieces of it, and nobody owned errors."],
  ["stakes", "Stakes", "One in twelve payments failed at peak. Support tickets doubled in a quarter."],
  ["action", "Action", "I proposed moving checkout in house, wrote the plan, and got platform, payments and support to split the work."],
  ["result", "Result", "Checkout errors dropped 40 percent in six weeks, and tickets went back to their old level."],
  ["reflection", "Reflection", "I'd bring support in on day one. They saw the failure patterns months before we did."],
] as const;
const STORY_SKILLS = ["Ownership", "Cross-team influence", "Impact"];

const COVERAGE = [
  { skill: "Ownership", stories: 3, state: "covered" },
  { skill: "Cross-team influence", stories: 2, state: "covered" },
  { skill: "Impact", stories: 2, state: "covered" },
  { skill: "Judgment", stories: 1, state: "thin" },
  { skill: "Conflict", stories: 0, state: "gap" },
  { skill: "Failure and learning", stories: 0, state: "gap" },
] as const;
const COVERAGE_LABEL = { covered: "Covered", thin: "One story", gap: "Gap" } as const;

// The coach conversation: it asks for what's missing (the IV-3 rules) and never adds facts.
const COACH_TURNS = [
  ["coach", "Coach", "You said checkout errors “went down a lot”. Do you know by how much, and over what time?"],
  ["you", "You", "About 40 percent. We measured it over the six weeks after launch."],
  ["coach", "Coach", "That's your result. Now the action: what did you propose yourself, and who had to agree?"],
] as const;
const COACH_PARTS = [
  ["context", "Context", "filled"],
  ["stakes", "Stakes", "filled"],
  ["action", "Action", "asking"],
  ["result", "Result", "filled"],
  ["reflection", "Reflection", "empty"],
] as const;
const PART_STATE = { filled: "Filled", asking: "Asking now", empty: "Not yet" } as const;
const COACH_POINTS = [
  ["Your words, not ours", "The coach asks for your role, a number, a concrete example and the trade-off. It never adds a fact you didn't say."],
  ["Gentle or direct", "Pick the coaching style. Gentle encourages and suggests; direct names the gap and moves on."],
  ["Voice or text", "Talk it through out loud the way you will in the room, or type when you can't."],
  ["Takes, scored", "Tell the story again as a take. Each one is scored 1 to 4 on the story's skills, so you can see it improve."],
  ["Two lengths", "Get a 60-second version and a full version, built from your own words."],
  ["Proven, not just written", "A story turns Proven when a Realistic answer that used it meets the bar."],
] as const;

// The interview plan: one page per job and resume.
const PLAN_TESTS = [
  ["Customer focus", 30],
  ["Ownership", 25],
  ["Cross-team influence", 20],
  ["Judgment", 15],
  ["Impact at scale", 10],
] as const;
const STORY_FIT = [
  ["Customer focus", "Checkout migration", "strong"],
  ["Ownership", "Checkout migration", "strong"],
  ["Cross-team influence", "Pricing page launch", "thin"],
  ["Judgment", "No story yet", "missing"],
] as const;
const FIT_LABEL = { strong: "Strong", thin: "Thin", missing: "Missing" } as const;
const READINESS = [
  ["Customer focus", 3],
  ["Ownership", 3],
  ["Cross-team influence", 2],
  ["Judgment", 1],
] as const;
const DAY_PLAN = [
  ["Today", "Build a Judgment story with the coach"],
  ["Tomorrow", "Realistic behavioral rehearsal, 30 minutes"],
  ["Day 3", "Two takes of the pricing story, aim for the result"],
  ["Day 4", "Recruiter screen rehearsal"],
] as const;
const INTERVIEW_TYPES = ["Behavioral", "Hiring manager deep dive", "Verbal technical Q&A", "Case", "Recruiter screen"];

// The annotated answer: each span is a strength ("win") or a leak, with a numbered note.
const STORY = [
  { n: 1, kind: "win", text: "I led the checkout migration across three teams", end: ". " },
  { n: 2, kind: "leak", text: "It was really challenging and we improved things a lot", end: ". " },
  { n: 3, kind: "flow", text: "Before that, actually, we'd tried a vendor, which didn't work", end: ". " },
  { n: 4, kind: "leak", text: "We decided to phase the rollout", end: ", " },
  { n: 5, kind: "win", text: "and checkout errors dropped 40 percent in six weeks", end: "." },
] as const;
const STORY_NOTES = [
  ["1", "win", "Relevant", "Matches the role's ask: leading without authority across teams."],
  ["2", "leak", "Vague", "“A lot” isn't evidence. Name the problem and the number."],
  ["3", "flow", "Coherence", "The timeline jumps back. Open with the failed vendor, then your plan."],
  ["4", "leak", "Ownership", "“We decided.” What did you propose, and who signed off?"],
  ["5", "win", "Evidence", "A clear result with a measure and a timeframe. Keep it."],
  ["", "gap", "Missing", "No reflection. At senior level, say what you'd change."],
] as const;
const STORY_SCORES = [
  ["Relevance", 4],
  ["Coherence", 2],
  ["Evidence", 3],
  ["Ownership", 2],
  ["Scope for the level", 3],
] as const;

// The tone and difficulty demo (TN-1, IV-4). public/js/tone-demo.js reads this table from the
// JSON block below. "Like the company" uses the company profile's interviewer persona; here, a
// made-up customer-first one.
const TONES = [
  ["company", "Like the company"],
  ["warm", "Warm"],
  ["neutral", "Neutral"],
  ["direct", "Direct"],
] as const;
const LEVELS = [
  ["friendly", "Friendly"],
  ["realistic", "Realistic"],
  ["tough", "Tough"],
] as const;
const DEMO = {
  replies: {
    company: {
      friendly: "Let's bring it back to the customer. What did you suggest to get things moving for them?",
      realistic: "How was it resolved, and what did the wait cost your customers? What did you propose?",
      tough: "Customers were failing at checkout while you went back and forth. What did you propose, who said no, and how did you decide?",
    },
    warm: {
      friendly: "That sounds like a tricky stretch. What did you suggest to get things moving?",
      realistic: "I'd love to hear how it ended. What did you propose, and who made the call?",
      tough: "Let's stay there a moment. What exactly did you propose, who disagreed, and what did resolving it cost?",
    },
    neutral: {
      friendly: "What did you suggest to get things moving?",
      realistic: "How was it resolved? What did you propose, and who made the final call?",
      tough: "You moved on, but was it resolved? Walk me through your proposal, the objection and the decision.",
    },
    direct: {
      friendly: "So what was your proposal?",
      realistic: "That doesn't tell me how it was resolved. What did you propose?",
      tough: "Moving on isn't a resolution. What did you propose, who said no, and what would you do differently?",
    },
  },
  notes: {
    friendly: "Friendly: one gentle follow-up, then it moves on. Good for a first run.",
    realistic: "Realistic: it keeps probing until it has evidence, the way most real interviewers do.",
    tough: "Tough: it presses on every gap in the story and asks for the trade-off you skipped.",
  },
  labels: Object.fromEntries([...TONES, ...LEVELS]),
};
const DEFAULT_TONE = "company";
const DEFAULT_LEVEL = "realistic";

// The v2 debrief (DB-1, DB-2, DM-1, DM-2, TR-1, ST-2, ST-6).
const DEBRIEF_FACTS = [
  ["Hire signal", "Lean Hire", "Up from Lean No Hire last time"],
  ["Answers that met the bar", "4 of 6", "A score of 3 or more"],
  ["Speaking pace", "178 wpm", "Faster than usual. Normal is 110 to 170 words a minute."],
  ["Filler words", "2 a minute", "In the normal range"],
] as const;
const DEBRIEF_ACTIONS = [
  ["Story used", "Each answer shows the story you told, and its fix goes to that story as a note."],
  ["Save as a story", "Turn any answer into a Draft story, with skill tags from how it was scored."],
  ["Full transcript", "Read every turn of the interview. Delivery comes from the text and timing; no audio is kept."],
] as const;

const CONTEXTS = [
  {
    tag: "Context A",
    title: "Senior PM, payments, a company that values customer obsession",
    meets: true,
    why: "Checkout errors are a customer metric in the team's own domain. The cross-team scope fits the level.",
  },
  {
    tag: "Context B",
    title: "Staff engineer, infrastructure, a company that values technical depth",
    meets: false,
    why: "No architecture decision or trade-off in the story. Three teams is small scope for staff.",
  },
];
---

<Base
  title="Strong Hire: build your stories, then face an interviewer who has done the homework"
  description="An AI story coach and voice interview simulator. Build your career stories with a coach, then rehearse with an interviewer that has studied the company, the role and your resume, and get a debrief you can act on. For tech candidates in the US and Canada."
  waitlist={CTA === "waitlist"}
>
  <section class="home-hero">
    <div class="wrap">
      <div class="home-hero__intro">
        <p class="pill"><span class="dot" aria-hidden="true"></span>AI story coach and interview simulator</p>
        <h1>An interviewer who has done the homework.</h1>
        <p class="lede">
          Build your stories with a coach that asks the right questions. Then rehearse with an interviewer that has
          studied how the company interviews, what the role demands at your level, and what your resume can and can't
          prove.
        </p>
        <div class="actions">
          {
            CTA === "signup" ? (
              <a class="btn" href={signupUrl("site")}>Start free</a>
            ) : (
              <a class="btn" href="#join">Join the beta waitlist</a>
            )
          }
          <a class="btn btn--ghost" href="#journeys">See how it works</a>
        </div>
        <p class="small muted">For engineers, product managers, data, design and TPM candidates.</p>
      </div>

      <div class="brief-flow">
        <ul class="brief-sources">
          {
            SOURCES.map(([tag, title, body]) => (
              <li class="card">
                <p class="tag">{tag}</p>
                <h2>{title}</h2>
                <p class="small muted">{body}</p>
              </li>
            ))
          }
        </ul>
        <svg class="brief-arrow" width="48" height="48" viewBox="0 0 48 48" aria-hidden="true">
          <path d="M6 24 H40 M30 14 L40 24 L30 34" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <section class="brief" aria-labelledby="brief-title">
          <div class="brief__head">
            <h2 id="brief-title">Your interviewer's brief</h2>
            <p class="tag">Example · Senior PM · Behavioral</p>
          </div>
          <h3 class="eyebrow">Competencies to test</h3>
          <ul class="chips">{BRIEF_COMPETENCIES.map((c) => <li>{c}</li>)}</ul>
          <h3 class="eyebrow">Where it will probe</h3>
          <ul class="probes">{BRIEF_PROBES.map((p) => <li>{p}</li>)}</ul>
          <dl class="brief__facts">
            <div><dt>Questions, ranked</dt><dd>8</dd></div>
            <div><dt>Tone</dt><dd>Your pick</dd></div>
            <div><dt>Bar it scores to</dt><dd>Senior</dd></div>
          </dl>
        </section>
      </div>
    </div>
  </section>

  <section class="section home-section" id="journeys" aria-labelledby="journeys-title">
    <div class="wrap">
      <p class="eyebrow">Two ways in</p>
      <h2 id="journeys-title">Start with your stories, or start with the interview.</h2>
      <p class="lede">
        Most people do both: build a few strong stories, then rehearse them for the job you want. Each one feeds the
        other.
      </p>
      <div class="journeys">
        {
          JOURNEYS.map((j) => (
            <article class={`journey journey--${j.kind}`}>
              <p class="tag">{j.tag}</p>
              <h3>{j.title}</h3>
              <p class="muted">{j.body}</p>
              <ol class="journey__steps">{j.steps.map((s) => <li>{s}</li>)}</ol>
              <p><a href={j.href}>{j.link}</a></p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt home-section" id="stories" aria-labelledby="stories-title">
    <div class="wrap">
      <p class="eyebrow eyebrow--action">Your story library</p>
      <h2 id="stories-title">Your career, told as stories that hold up.</h2>
      <p class="lede">
        A story is one moment from your work in five parts. Keep them in one library, tagged by the skills they show,
        and see which skills still have no story.
      </p>
      <div class="library">
        <article class="story-card card" aria-labelledby="story-card-title">
          <div class="story-card__head">
            <h3 id="story-card-title">Checkout migration across three teams</h3>
            <p class="status status--proven">
              <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 8.5 L6.5 12 L13 4.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              Proven
            </p>
          </div>
          <ul class="chips chips--light" aria-label="Skills">{STORY_SKILLS.map((s) => <li>{s}</li>)}</ul>
          <ol class="parts">
            {
              STORY_PARTS.map(([id, label, text]) => (
                <li class={`part part--${id}`}>
                  <span class="part__label">{label}</span>
                  <p>{text}</p>
                </li>
              ))
            }
          </ol>
          <p class="small muted">Example story. Proven: a Realistic answer that used it scored 3 or more.</p>
        </article>
        <aside class="coverage card" aria-labelledby="coverage-title">
          <h3 id="coverage-title" class="eyebrow">Skills your stories cover</h3>
          <ul>
            {
              COVERAGE.map((c) => (
                <li class={`coverage__row coverage__row--${c.state}`}>
                  <span>{c.skill}</span>
                  <span class="coverage__count">
                    <span class="mono">{c.stories}</span>
                    <span class={`coverage__state coverage__state--${c.state}`}>{COVERAGE_LABEL[c.state]}</span>
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="small muted">
            Gaps are the skills you'll be asked about with no story ready. Build one with the coach, or save one from a
            rehearsal answer.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section home-section" id="coach" aria-labelledby="coach-title">
    <div class="wrap">
      <p class="eyebrow eyebrow--action">The story coach</p>
      <h2 id="coach-title">A coach that asks. It never invents.</h2>
      <p class="lede">
        Tell it what happened. It asks for what an interviewer will want, the way a good mentor would, and fills in the
        story as you talk.
      </p>
      <div class="coach">
        <figure class="coach__chat" aria-labelledby="coach-chat-cap">
          <figcaption id="coach-chat-cap" class="tag">Coach session · Example · Direct style</figcaption>
          <ol class="turns">
            {
              COACH_TURNS.map(([who, label, text]) => (
                <li class={`turn turn--${who}`}>
                  <span class="turn__who">{label}</span>
                  <p>{text}</p>
                </li>
              ))
            }
          </ol>
          <div class="coach__parts">
            <h3 class="eyebrow">Story parts</h3>
            <ul>
              {
                COACH_PARTS.map(([id, label, state]) => (
                  <li class={`part-chip part-chip--${id} part-chip--${state}`}>
                    <span class="part-chip__name">{label}</span>
                    <span class="part-chip__state">{PART_STATE[state]}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </figure>
        <ul class="points">
          {
            COACH_POINTS.map(([title, body]) => (
              <li>
                <h3>{title}</h3>
                <p class="muted">{body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--prep home-section" id="prep" aria-labelledby="prep-title">
    <div class="wrap">
      <p class="eyebrow eyebrow--prep">Interview prep</p>
      <h2 id="prep-title">One plan for each interview.</h2>
      <p class="lede">
        Add the job posting and your resume. Strong Hire checks your CV against the job and builds one plan that
        counts down to the day.
      </p>
      <div class="plan card" aria-labelledby="plan-title">
        <div class="plan__head">
          <div>
            <p class="tag">Example plan</p>
            <h3 id="plan-title">Senior product manager, payments</h3>
          </div>
          <dl class="plan__stats">
            <div><dt>Match</dt><dd>72</dd></div>
            <div><dt>Days left</dt><dd>9</dd></div>
          </dl>
        </div>
        <div class="plan__grid">
          <section aria-labelledby="plan-tests">
            <h4 id="plan-tests" class="eyebrow">What they'll test</h4>
            <ul class="weights">
              {
                PLAN_TESTS.map(([skill, weight]) => (
                  <li>
                    <span class="score-row">
                      <span>{skill}</span>
                      <span class="mono">{weight}%</span>
                    </span>
                    <span class="meter meter--prep">
                      <span class={`meter__fill meter__fill--w${weight}`}></span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </section>
          <section aria-labelledby="plan-fit">
            <h4 id="plan-fit" class="eyebrow">Story fit</h4>
            <table class="fit">
              <thead>
                <tr><th scope="col">Skill</th><th scope="col">Best story</th><th scope="col">Fit</th></tr>
              </thead>
              <tbody>
                {
                  STORY_FIT.map(([skill, story, fit]) => (
                    <tr>
                      <th scope="row">{skill}</th>
                      <td class={fit === "missing" ? "muted" : undefined}>{story}</td>
                      <td><span class={`fit-badge fit-badge--${fit}`}>{FIT_LABEL[fit]}</span></td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </section>
          <section aria-labelledby="plan-ready">
            <h4 id="plan-ready" class="eyebrow">Practice readiness</h4>
            <ul class="readiness">
              {
                READINESS.map(([skill, level]) => (
                  <li>
                    <span>{skill}</span>
                    <span class="rubric" role="img" aria-label={`${level} of 4`}>
                      {[1, 2, 3, 4].map((n) => <span class={n <= level ? "on" : undefined}></span>)}
                    </span>
                  </li>
                ))
              }
            </ul>
            <p class="small muted">{READINESS_NOTICE}</p>
          </section>
          <section aria-labelledby="plan-days">
            <h4 id="plan-days" class="eyebrow">Day by day</h4>
            <ol class="days">
              {
                DAY_PLAN.map(([day, task]) => (
                  <li>
                    <span class="mono">{day}</span>
                    <span>{task}</span>
                  </li>
                ))
              }
            </ol>
          </section>
        </div>
      </div>
      <p class="types">
        <span class="muted">Rehearse any of five interview types:</span>
        {INTERVIEW_TYPES.map((t) => <span class="type">{t}</span>)}
        <span class="muted">or a Custom interview from your own questions.</span>
      </p>
    </div>
  </section>

  <section class="section section--alt home-section" id="how" aria-labelledby="story-title">
    <div class="wrap">
      <p class="eyebrow">How it listens</p>
      <h2 id="story-title">It hears what your story actually proves.</h2>
      <p class="lede">
        Relevance, coherence, evidence, ownership. Sentence by sentence, you see where a story wins and where it leaks.
      </p>
      <div class="story">
        <figure class="story__answer">
          <figcaption class="tag">Q · Tell me about a project you led across teams. Example answer.</figcaption>
          <p class="story__text">
            {
              STORY.map((s) => (
                <><mark class={`ann ann--${s.kind}`}>{s.text}</mark><sup class={`ann-n ann-n--${s.kind}`}>{s.n}</sup>{s.end}</>
              ))
            }
          </p>
          <ol class="story__notes">
            {
              STORY_NOTES.map(([n, kind, label, body]) => (
                <li>
                  <span class={`ann-label ann-n--${kind}`}>
                    {n} {label}
                  </span>
                  {body}
                </li>
              ))
            }
          </ol>
        </figure>
        <aside class="story__scores card" aria-labelledby="scores-title">
          <h3 id="scores-title" class="eyebrow">This story, scored for this role</h3>
          <ul>
            {
              STORY_SCORES.map(([name, score]) => (
                <li>
                  <span class="score-row">
                    <span>{name}</span>
                    <span class="mono">{score}/4</span>
                  </span>
                  <span class="meter" role="img" aria-label={`${name}: ${score} out of 4`}>
                    <span class={`meter__fill meter__fill--${score}`}></span>
                  </span>
                </li>
              ))
            }
          </ul>
          <div class="story__fix">
            <h3 class="eyebrow">Fix first</h3>
            <p>Lead with the failed vendor, say what you proposed, keep the 40 percent, and close with what you'd change.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section home-section" aria-labelledby="room-title">
    <div class="wrap room">
      <div>
        <p class="eyebrow">Set the room</p>
        <h2 id="room-title">Choose who you face.</h2>
        <p class="lede">
          Pick the interviewer's tone and how hard it pushes. Warm up with a friendly one, then rehearse against the
          toughest one you might meet. Tone never changes your score.
        </p>
        <div class="room__controls" data-tone-demo-controls hidden>
          <fieldset>
            <legend>Tone</legend>
            <div class="segmented">
              {
                TONES.map(([id, label]) => (
                  <button type="button" data-tone={id} aria-pressed={id === DEFAULT_TONE ? "true" : "false"}>
                    {label}
                  </button>
                ))
              }
            </div>
          </fieldset>
          <fieldset>
            <legend>Difficulty</legend>
            <div class="segmented">
              {
                LEVELS.map(([id, label]) => (
                  <button type="button" data-level={id} aria-pressed={id === DEFAULT_LEVEL ? "true" : "false"}>
                    {label}
                  </button>
                ))
              }
            </div>
          </fieldset>
        </div>
      </div>
      <div class="room__demo">
        <div class="card">
          <p class="tag">You said</p>
          <p class="room__said">
            “We went back and forth with the platform team for a while, and then we moved on to the next milestone.”
          </p>
        </div>
        <div class="room__reply" aria-live="polite">
          <p class="tag tag--stage">
            <span class="dot" aria-hidden="true"></span>Interviewer · <span data-tone-demo-label>
              {DEMO.labels[DEFAULT_TONE]} · {DEMO.labels[DEFAULT_LEVEL]}
            </span>
          </p>
          <p class="room__line">“<span data-tone-demo-reply>{DEMO.replies[DEFAULT_TONE][DEFAULT_LEVEL]}</span>”</p>
        </div>
        <p class="small muted" data-tone-demo-note>{DEMO.notes[DEFAULT_LEVEL]}</p>
      </div>
    </div>
    <script is:inline type="application/json" id="tone-demo-data" set:html={JSON.stringify(DEMO)} />
  </section>

  <section class="section section--alt home-section" id="debrief" aria-labelledby="debrief-title">
    <div class="wrap">
      <p class="eyebrow">After the interview</p>
      <h2 id="debrief-title">A debrief you can act on.</h2>
      <p class="lede">
        A hire signal with the reasons, a 1 to 4 score per answer with quotes, and how you sounded. Then one fix, sent to
        the story that needs it.
      </p>
      <dl class="facts">
        {
          DEBRIEF_FACTS.map(([label, value, note]) => (
            <div class="card">
              <dt>{label}</dt>
              <dd class="facts__value">{value}</dd>
              <dd class="small muted">{note}</dd>
            </div>
          ))
        }
      </dl>
      <ul class="trio trio--plain">
        {
          DEBRIEF_ACTIONS.map(([title, body]) => (
            <li>
              <h3>{title}</h3>
              <p class="muted">{body}</p>
            </li>
          ))
        }
      </ul>
      <p><a href="/sample-debrief">See a sample debrief</a></p>
    </div>
  </section>

  <section class="section home-section" aria-labelledby="context-title">
    <div class="wrap">
      <h2 id="context-title">Same story. Different job. Different verdict.</h2>
      <p class="lede">
        A good answer depends on who's asking. Strong Hire weighs your story against the company's values, the role's
        needs and the bar for your level.
      </p>
      <div class="grid-2">
        {
          CONTEXTS.map((c) => (
            <div class="card">
              <p class="tag">{c.tag}</p>
              <h3>{c.title}</h3>
              <p class={c.meets ? "badge badge--ok" : "badge badge--below"}>
                {c.meets && (
                  <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3 8.5 L6.5 12 L13 4.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {c.meets ? "Meets the bar" : "Below the bar"}
              </p>
              <p class="muted">{c.why}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt home-section" aria-labelledby="minds-title">
    <div class="wrap">
      <h2 id="minds-title">One AI asks. A different one judges.</h2>
      <div class="grid-2 minds">
        <div class="minds__item minds__item--live">
          <p class="tag">During · the interviewer</p>
          <h3>Fast, in character, adaptive</h3>
          <p class="muted">
            Works from the brief, follows up when an answer is thin and moves on when it has the evidence. It replies at
            conversation speed, like a person across the table.
          </p>
        </div>
        <div class="minds__item minds__item--verdict">
          <p class="tag">After · the scorer</p>
          <h3>Slow, thorough, unswayed</h3>
          <p class="muted">
            Reads the full transcript afterward, the way a debrief panel reads notes. It wasn't in the conversation, so it
            can't go easy on you.
          </p>
        </div>
      </div>
      <div class="trio">
        <div class="card">
          <h3>Private by design</h3>
          <p class="muted">
            Audio is never stored. Export or delete your resumes, stories and transcripts in one click. Nothing is used
            for training unless you turn that on.
          </p>
          <p><a href="/legal/privacy">Read the privacy policy</a></p>
        </div>
        <div class="card">
          <h3>Start free</h3>
          <p class="muted">
            Unlimited gap analyses and two 10-minute mini interviews, each with a debrief. Paid plans add full 30 and
            45-minute interviews.
          </p>
          <p><a href="/pricing">How plans work</a></p>
        </div>
        <div class="card">
          <h3>Profiles of how companies interview</h3>
          <p class="muted">{companiesLine}</p>
          <p class="notice">{NOT_AFFILIATED}</p>
        </div>
      </div>
      <p class="small muted">{PRACTICE_NOTICE}</p>
    </div>
  </section>

  {
    CTA === "waitlist" && (
      <section class="section home-join">
        <div class="wrap grid-2">
          <div>
            <h2>Meet your interviewer before theirs.</h2>
            <p>
              The beta opens in stages, soonest interviews first. Join and we'll email you when your place is ready.
            </p>
            <p class="home-join__note">Free accounts get unlimited gap analyses and two 10-minute mini interviews.</p>
          </div>
          <WaitlistForm />
        </div>
      </section>
    )
  }
  <script is:inline src="/js/tone-demo.js" defer></script>
</Base>
