---
import Base from "../layouts/Base.astro";
import Rubric from "../components/Rubric.astro";
import SignalScale from "../components/SignalScale.astro";
import { PRACTICE_NOTICE } from "../data/site";
import { SAMPLE_IS_PLACEHOLDER, sample } from "../data/sample-debrief";

// DB-2: an answer meets the bar at a rubric score of 3 or more. DM-2: the app's normal range.
const met = sample.questions.filter((q) => q.score >= 3).length;
const PACE = { min: 110, max: 170 };
const paceNote = (wpm: number) =>
  wpm > PACE.max ? "faster than usual" : wpm < PACE.min ? "slower than usual" : "in the normal range";
---

<Base
  title="Sample debrief | Strong Hire"
  description="What you get after a Strong Hire interview: a hire signal with the reasons and the change since last time, a score per question with quoted evidence, the story you used, how you sounded, and what to fix first."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Sample debrief</p>
      <h1>{sample.interview}</h1>
      {
        SAMPLE_IS_PLACEHOLDER ? (
          <p class="placeholder">
            An illustration of the debrief format. The answers are made up; no real candidate is quoted.
          </p>
        ) : (
          <p class="placeholder">
            The real debrief of a simulated candidate, scored by Strong Hire. No real candidate is quoted.
          </p>
        )
      }

      <div class="card verdict">
        <h2>Hire signal: {sample.hire_signal}</h2>
        <SignalScale signal={sample.hire_signal} />
        <p>{sample.rationale}</p>
        <p>
          <b>{met} of {sample.questions.length}</b> answers met the bar (a score of 3 or more). Last session for this job:
          {sample.previous_signal}.
        </p>
        <p class="small muted">{PRACTICE_NOTICE}</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <h2>Competencies</h2>
      <div class="table-scroll">
        <table class="score-table">
          <thead>
            <tr><th scope="col">Competency</th><th scope="col">Score</th><th scope="col">Why</th></tr>
          </thead>
          <tbody>
            {
              sample.competencies.map((c) => (
                <tr>
                  <th scope="row">{c.name}</th>
                  <td>
                    <Rubric score={c.score} />
                  </td>
                  <td>{c.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="small muted">Scores run from 1 (no evidence) to 4 (above the bar for the level).</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack">
      <h2>Question by question</h2>
      {
        sample.questions.map((q) => (
          <article class="card">
            <h3>{q.question}</h3>
            <p>
              <Rubric score={q.score} /> {q.score} of 4
            </p>
            <blockquote>{q.evidence}</blockquote>
            <p>{q.feedback}</p>
            <p class="small muted">
              Story used: {q.story}. Pace {q.delivery.wpm} words a minute ({paceNote(q.delivery.wpm)}),{" "}
              {q.delivery.fillers} filler words a minute.
            </p>
          </article>
        ))
      }
      <div class="card">
        <h2>Fix these first</h2>
        <ol>{sample.fix_first.map((f) => <li>{f}</li>)}</ol>
        <p class="small muted">
          Each answer's fix is also sent to the story you used, as a note. Any answer can be saved as a new story. Pace
          and filler words come from the transcript and its timing; no audio is kept.
        </p>
      </div>
    </div>
  </section>
</Base>
