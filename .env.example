# Copy to .env (scripts/dev.ps1 does this on first run). Values here are for local development only.

# --- Fixed host ports (change here if a port is taken on your machine) ---
WEB_PORT=5180
API_PORT=8700
POSTGRES_PORT=55432
REDIS_PORT=56379
OLLAMA_PORT=11435
LITELLM_PORT=4000
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
VOICE_HEALTH_PORT=8081
STT_PORT=8010
TTS_PORT=8880

# --- Postgres ---
POSTGRES_USER=strong
POSTGRES_PASSWORD=strong
POSTGRES_DB=strong

# --- Models ---
# fake   = recorded fixtures, no model needed (default, used by tests and CI)
# local  = config/models.local.yaml through LiteLLM + Ollama (needs the "models" profile)
# hosted = config/models.hosted.yaml through LiteLLM + hosted APIs (needs provider keys below)
MODEL_PROFILE=fake
# Which LiteLLM config the proxy loads: config/litellm.<LITELLM_PROFILE>.yaml
LITELLM_PROFILE=local
LITELLM_MASTER_KEY=sk-local-dev-only

# Hosted provider key (only for LITELLM_PROFILE=hosted). config/litellm.hosted.yaml says which
# provider it belongs to. Never commit real keys.
HOSTED_API_KEY=

# --- LiveKit (dev mode uses these fixed keys) ---
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Job and resume inputs (P2) ---
# Encrypted resume files. Default folder: ~/.strong-hire/uploads. In dev and test a missing key
# is created once in that folder. Outside dev and test, set a Fernet key:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INPUTS_STORAGE_DIR=
INPUTS_STORAGE_KEY=

# --- P03 auth/web ---
# local = dev login exists and magic links are shown on the sign-in page. Hosting sets production.
APP_ENV=local
# Signs the session cookie and magic links. Outside local it must be 32+ random characters.
SESSION_SECRET=local-dev-only-session-secret-change-me
# Google OAuth (optional locally). Redirect URI: http://localhost:5180/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the browser app lives, and the API as the browser sees it (through the web proxy)
WEB_BASE_URL=http://localhost:5180
API_PUBLIC_URL=http://localhost:5180/api
# Magic link email. With no SMTP_HOST the link is written to the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Web app mocks in development: planned (default), all, or off. See apps/web/README.md.
VITE_API_MOCKS=planned
