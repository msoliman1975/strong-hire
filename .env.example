# Copy to .env (scripts/dev.ps1 does this on first run). Values here are for local development only.

# --- Fixed host ports (change here if a port is taken on your machine) ---
WEB_PORT=5180
API_PORT=8700
POSTGRES_PORT=55432
REDIS_PORT=56379
OLLAMA_PORT=11435
LITELLM_PORT=4000
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
VOICE_HEALTH_PORT=8081
STT_PORT=8010
TTS_PORT=8880

# --- Postgres ---
POSTGRES_USER=strong
POSTGRES_PASSWORD=strong
POSTGRES_DB=strong

# --- Models ---
# fake   = recorded fixtures, no model needed (default, used by tests and CI)
# tiny   = config/models.tiny.yaml: one small model for all text roles, CPU ("all-in-one" profile)
# local  = config/models.local.yaml through LiteLLM + Ollama (needs the "models" profile)
# hosted = config/models.hosted.yaml through LiteLLM + hosted APIs (needs provider keys below)
# claude = Anthropic models for text, local speech; needs ANTHROPIC_API_KEY in your environment
# Switch with ./scripts/profile.ps1 <name>: it edits the 2 lines below and restarts services.
MODEL_PROFILE=fake
# Which LiteLLM config the proxy loads: config/litellm.<LITELLM_PROFILE>.yaml
LITELLM_PROFILE=local
LITELLM_MASTER_KEY=sk-local-dev-only

# Hosted provider key (only for LITELLM_PROFILE=hosted). config/litellm.hosted.yaml says which
# provider it belongs to. Never commit real keys.
HOSTED_API_KEY=

# --- claude profile: cost limits (./scripts/profile.ps1 claude applies them) ---
# The Anthropic key is NOT stored here: set ANTHROPIC_API_KEY as a Windows user variable.
# The app uses a LiteLLM key with these limits. Once a budget is used, model calls fail with
# an error until it resets (daily at 00:00 UTC, monthly on the 1st).
# Also set a monthly limit in the Anthropic Console: it is the hard limit.
CLAUDE_DAILY_BUDGET_USD=5
CLAUDE_MONTHLY_BUDGET_USD=30
CLAUDE_RPM_LIMIT=60
# Written by ./scripts/profile.ps1 claude; empty means the app uses the master key.
LITELLM_APP_KEY=
LITELLM_TEAM_ID=

# --- LiveKit (dev mode uses these fixed keys) ---
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Job and resume inputs (P2) ---
# Encrypted resume files. Default folder: ~/.strong-hire/uploads. In dev and test a missing key
# is created once in that folder. Outside dev and test, set a Fernet key:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INPUTS_STORAGE_DIR=
INPUTS_STORAGE_KEY=

# --- P03 auth/web ---
# local = dev login exists and magic links are shown on the sign-in page. Hosting sets production.
APP_ENV=local
# Signs the session cookie and magic links. Outside local it must be 32+ random characters.
SESSION_SECRET=local-dev-only-session-secret-change-me
# Google OAuth (optional locally). Redirect URI: http://localhost:5180/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the browser app lives, and the API as the browser sees it (through the web proxy)
WEB_BASE_URL=http://localhost:5180
API_PUBLIC_URL=http://localhost:5180/api
# Magic link email. With no SMTP_HOST the link is written to the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Web app mocks in development: off (default) or all. See apps/web/README.md.
VITE_API_MOCKS=off

# --- P9 billing and accounts ---
# Stripe in test mode. Leave empty until a Stripe account exists: the app then shows the plan,
# but checkout and the portal answer 503. Never put live keys (sk_live_) here.
#   STRIPE_SECRET_KEY      sk_test_... (Stripe dashboard, Developers, API keys)
#   STRIPE_WEBHOOK_SECRET  whsec_... (printed by `stripe listen`, or the webhook endpoint page)
#   STRIPE_PRICE_ID        price_... of the monthly plan
# See apps/api/src/strong_api/billing/README.md for the setup and the local test steps.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# The plan shown to users. Keep BILLING_PRICE_USD_MONTH equal to the Stripe price.
BILLING_PRICE_USD_MONTH=29
BILLING_MINUTES_CAP=300
BILLING_FREE_INTERVIEWS=2
# Data export (AC-1): how long a finished export waits for its one download, and its size limit.
ACCOUNT_EXPORT_TTL_S=86400
ACCOUNT_EXPORT_MAX_MB=100

# Kokoro TTS address for LiteLLM. Empty: the tts container. To run Kokoro on Windows (faster on a
# laptop), run ./scripts/kokoro-windows.ps1 and set:
#   TTS_API_BASE=http://host.rancher-desktop.internal:8881/v1
TTS_API_BASE=
